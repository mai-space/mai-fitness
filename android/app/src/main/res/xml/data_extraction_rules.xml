<?xml version="1.0" encoding="utf-8"?>
<!-- Trainingsdaten nie in Google-Backups oder Gerätetransfer: die Datenbank ist
     mit einem Keystore-Schlüssel verschlüsselt, der das Gerät nicht verlässt.
     Umzug nur über die verschlüsselte .maifit-Sicherung. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
